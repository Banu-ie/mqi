# Frontend build-time configuration.
# Copy to .env (local development) or .env.production (production build).
# Vite only exposes variables prefixed with VITE_ to the browser, so never put
# a secret in this file — everything here ships inside the JS bundle.

# Full base URL of the backend API, including the /api path and no trailing slash.
# Local development:  http://localhost:4000/api
# Production:         https://your-backend-host.example.com/api
VITE_API_URL="http://localhost:4000/api"
