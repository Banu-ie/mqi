# PostgreSQL connection string. Required — the server exits on boot without it.
# Local:  postgresql://localhost:5432/mqicma_dev
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://localhost:5432/mqicma_dev"

# Optional split-role setup: DATABASE_URL is the limited app login; this URL is
# reserved for migrations and should be used only by a release/migration job.
DATABASE_MIGRATION_URL=""
DATABASE_RUNTIME_ROLE=""
RUN_MIGRATIONS="true"

# The application keeps its tables in this schema rather than `public`, so it
# can share a database without colliding with other tables. Creating it needs
# CREATE on the database; see the README if you get "permission denied".
DATABASE_SCHEMA="mqicma"

# Max pooled connections. Keep it low on serverless Postgres.
DATABASE_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000

# Set to "true" only when running behind a reverse proxy / hosting platform.
TRUST_PROXY="false"

# Optional Cloudflare Turnstile protection for admin login and contact form.
# Configure both the server secret here and the matching public site key in
# frontend/.env; keep the secret out of all VITE_ variables.
TURNSTILE_SECRET_KEY=""

# Public contact form safeguards and cleanup policy.
CONTACT_GLOBAL_LIMIT=100
CONTACT_RETENTION_DAYS=90

CORS_ORIGIN="http://localhost:5173,http://localhost:4173,http://localhost:8443"

# Required when running `npm run seed`; use a unique local-only password.
SEED_ADMIN_EMAIL="your-admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password"

# Used only by `npm test`. Tests create a uniquely named schema here and drop it
# afterwards, but point this at a scratch database anyway.
TEST_DATABASE_URL="postgresql://localhost:5432/mqicma_test"
