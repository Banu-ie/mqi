# Backend production configuration. Set these as secrets in your hosting
# provider's dashboard — never commit the filled-in version.

# Managed PostgreSQL connection string. Use the *pooled* endpoint on Neon.
DATABASE_URL=""

# Dedicated schema for this application's tables.
DATABASE_SCHEMA="mqicma"
DATABASE_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=4000

# Required behind a hosting proxy so rate limiting sees the real client IP.
TRUST_PROXY="true"

# Only needed when the frontend is on a different origin than the API. With a
# single-origin setup (frontend proxies /api to the backend) leave this unset.
CORS_ORIGIN=""

# Only read by `npm run seed`. Use a strong password.
SEED_ADMIN_EMAIL="admin@mqicma.az"
SEED_ADMIN_PASSWORD=""
